# Enable API-based authentication (true/false)
VITE_USE_REMOTE_AUTH=false

# Base URL of your backend API (no trailing slash required)
# Example: http://localhost:3000
VITE_AUTH_API_URL=

# Backend API port
PORT=3000

# Exact frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB connection URI
# Example: mongodb://127.0.0.1:27017/rob-the-fab
MONGO_URI=

# Optional explicit DB name (if omitted, URI database is used)
MONGO_DB_NAME=

# JWT secret for signing tokens
JWT_SECRET=
